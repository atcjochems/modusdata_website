---
const targetUrl = new URL('/portfolio/self-hosted-llms/' + Astro.url.search, Astro.site ?? 'https://modusdata.ch');
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecting to: {targetUrl.href}</title>
    <meta http-equiv="refresh" content={`0;url=${targetUrl.href}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={targetUrl.href} />
  </head>
  <body>
    <p>Redirecting to <a href={targetUrl.href}>the Private AI service page</a>.</p>
  </body>
</html>
