---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../data/content';
import { getEntry } from 'astro:content';

const postEntry = await getEntry('pages', 'federated-learning');
if (!postEntry) throw new Error('Could not find federated-learning markdown');
const { Content } = await postEntry.render();
const data = content.en;
---

<BaseLayout
  title={`Breaking Data Silos in Pharma | ${data.title}`}
  description="How federated learning unlocks multi-center real-world evidence without moving raw patient data."
  type="article"
  publishedTime={postEntry.data.publishedTime}
  author="Arthur Jochems"
  tags={['Federated learning', 'Healthcare AI', 'Privacy-preserving machine learning', 'Real-world evidence']}
>
  <article class="markdown-content portfolio-article">
    <a class="back-link" href="/portfolio/">← Back to portfolio</a>
    <h1>{postEntry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
