---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { content } from '../../data/content';
import { getEntry } from 'astro:content';

const postEntry = await getEntry('pages', 'multi-modal-omics-radiomics-pipelines');
if (!postEntry) throw new Error('Could not find multi-modal-omics-radiomics-pipelines markdown');
const { Content } = await postEntry.render();
const data = content.en;
---

<BaseLayout
  title={`Multi-Modal Omics & Radiomics Pipelines | ${data.title}`}
  description="How Modus Data engineers scalable radiomics and multi-omics pipelines into validated, production-grade real-world evidence models."
  image="/img/assets/post_omics_radiomics/omics-radiomics-hero.jpg"
  type="article"
  publishedTime={postEntry.data.publishedTime}
  author="Arthur Jochems"
  tags={['Radiomics', 'Multi-omics', 'Healthcare AI', 'Real-world evidence', 'Federated learning']}
>
  <article class="markdown-content portfolio-article">
    <a class="back-link" href="/portfolio/">← Back to portfolio</a>
    <h1>{postEntry.data.title}</h1>
    <Content />
  </article>
</BaseLayout>
