---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<section class:list={['ecosystem-trust-strip', className]} aria-labelledby="ecosystem-trust-title">
  <p id="ecosystem-trust-title">Natively Integrated with Your Enterprise Ecosystem</p>
  <div class="ecosystem-trust-items">
    <div class="ecosystem-trust-item" aria-label="Microsoft AI Cloud Partner">
      <svg class="ecosystem-mark microsoft-mark" viewBox="0 0 20 20" role="img" aria-label="Microsoft AI Cloud Partner">
        <rect x="1" y="1" width="8" height="8" fill="currentColor" />
        <rect x="11" y="1" width="8" height="8" fill="currentColor" />
        <rect x="1" y="11" width="8" height="8" fill="currentColor" />
        <rect x="11" y="11" width="8" height="8" fill="currentColor" />
      </svg>
      <span>Microsoft AI Cloud Partner</span>
    </div>
    <div class="ecosystem-trust-item" aria-label="Google Cloud Partner">
      <img class="ecosystem-mark" src="/img/logos/google-cloud.svg" alt="Google Cloud Partner" />
      <span>Google Cloud Partner</span>
    </div>
    <div class="ecosystem-trust-item ecosystem-trust-item--secondary" aria-label="Azure OpenAI, LangGraph and OpenTelemetry">
      <span>Azure OpenAI</span><span aria-hidden="true">·</span><span>LangGraph</span><span aria-hidden="true">·</span><span>OpenTelemetry</span>
    </div>
  </div>
</section>
