---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description = 'Swiss AI and data science consulting for pharma, healthcare and life sciences.',
  image = '/img/og-image-v2.png',
  type = 'website',
  publishedTime,
  author = 'Arthur Jochems',
  tags = [],
} = Astro.props;
const siteUrl = Astro.site ?? new URL('https://modusdata.ch');
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const imageUrl = new URL(image, siteUrl).href;
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Modus Data GmbH',
  url: siteUrl.href,
  logo: new URL('/img/MD_logo.png', siteUrl).href,
  description,
  email: 'mailto:arthur@modusdata.ch',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Benkenstrasse 3',
    postalCode: '4106',
    addressLocality: 'Therwil',
    addressCountry: 'CH',
  },
  sameAs: ['https://www.linkedin.com/company/modus-data-gmbh/'],
};
const articleSchema = type === 'article' ? {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  url: canonicalUrl,
  image: imageUrl,
  author: { '@type': 'Person', name: author },
  publisher: organizationSchema,
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
} : null;
const links = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Modus Data" />
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === 'article' && <meta property="article:author" content={author} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/">
          <img class="brand-logo" src="/img/MD_logo.png" alt="Modus Data logo" />
          <span class="brand-copy">
            <strong>Modus Data</strong>
            <small>Production-grade AI</small>
          </span>
        </a>

        <nav class="site-nav" aria-label="Primary navigation">
          {links.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>
      </header>

      <main class="site-main">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-content">
          <div class="footer-brand">
            <strong>Modus Data GmbH</strong>
            <p>Pragmatic AI, data engineering and production systems for regulated organizations.</p>
            <div class="footer-meta" aria-label="Business information">
              <span>Therwil / Basel, Switzerland</span>
              <span>CHE-218.406.940</span>
            </div>
          </div>

          <div class="footer-side">
            <div class="footer-socials" aria-label="Social and contact links">
              <a class="social-link" href="https://www.linkedin.com/company/modus-data-gmbh/" target="_blank" rel="noreferrer" aria-label="LinkedIn">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M6.94 8.49a1.58 1.58 0 1 1 0-3.16 1.58 1.58 0 0 1 0 3.16ZM5.5 9.94h2.9v8.08H5.5V9.94Zm4.72 0h2.79v1.11h.04c.39-.74 1.35-1.52 2.77-1.52 2.96 0 3.5 1.95 3.5 4.47v4.02h-2.9v-3.76c0-1.42-.03-3.25-1.98-3.25-1.99 0-2.29 1.55-2.29 3.15v3.86h-2.93V9.94Z"/>
                </svg>
              </a>
              <a href="mailto:arthur@modusdata.ch">arthur@modusdata.ch</a>
            </div>

            <div class="footer-links">
              <a href="/services/">Services</a>
              <a href="/portfolio/">Portfolio</a>
              <a href="/about/">About</a>
              <a href="mailto:arthur@modusdata.ch">Contact</a>
            </div>
          </div>
        </div>

        <div class="footer-subfooter">
          <div class="footer-legal">
            <p>© 2026 Modus Data GmbH. All rights reserved.</p>
            <div class="legal-links" aria-label="Legal links">
              <a href="/impressum/">Impressum</a>
              <a href="/privacy-policy/">Privacy Policy</a>
            </div>
          </div>
          <div class="insurance-badge" aria-label="Exali Haftpflichtversicherung">
            <div class="insurance-wordmark">exali</div>
            <div class="insurance-mark" aria-hidden="true">
              <span class="insurance-check"></span>
            </div>
            <div class="insurance-tag">HAFTPFLICHT<br />SICHER</div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>